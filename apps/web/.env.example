# Cópialo a .env.local y rellénalo con los datos de tu proyecto Supabase
# (en local: `supabase start` los imprime; en la nube: Project Settings → API).
# Sin estas variables la app funciona igual, pero solo en modo "Jugar contra bots".
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# URL pública donde publiques la web (para los enlaces de invitación que se comparten desde la app nativa).
# En el navegador no hace falta: se usa la dirección actual.
VITE_PUBLIC_URL=
